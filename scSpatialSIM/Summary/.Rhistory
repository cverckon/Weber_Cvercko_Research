library(airway)
library(DESeq2)
library(clusterProfiler)
library(enrichplot)
library(org.Hs.eg.db)
library(fgsea)
library(msigdbr)
library(limma)
library(edgeR)
dge <- DGEList(counts = assay(airway), group = airway$dex)
# filter (same genes as DESeq2)
dge <- dge[keep, ]
# normalize
dge <- calcNormFactors(dge)
# design matrix
# using releveled factor in colData(se)
design <- model.matrix(~ cell + dex, data = colData(se))
# voom transformation
v <- voom(dge, design)
# fit linear model
fit <- lmFit(v, design)
fit <- eBayes(fit)
# ----- Prepare gene set indices -----
# camera and fry need gene set indices (row positions in the expression matrix)
# we need to map gene set symbols to row names (Ensembl IDs) of our data
# create mapping from symbol to Ensembl
sym_to_ens <- setNames(rownames(v), symbol_map[rownames(v)])
# remove NAs
sym_to_ens <- sym_to_ens[!is.na(names(sym_to_ens))]
# convert Hallmark gene sets to index lists
idx_list <- lapply(hallmark_list, function(genes) {
ens_ids <- sym_to_ens[intersect(genes, names(sym_to_ens))]
match(ens_ids, rownames(v))
})
# remove NAs and empty sets
idx_list <- lapply(idx_list, function(x) x[!is.na(x)])
idx_list <- idx_list[sapply(idx_list, length) >= 10]
length(idx_list)  # number of gene sets with sufficient overlap
# ----- camera: competitive gene set test -----
# accounts for inter-gene correlation
camera_res <- camera(
y = v,
index = idx_list,
design = design,
contrast = ncol(design)  # coefficient for 'dextrt'
)
head(camera_res, 20)
# how many significant?
table(camera_res$FDR < 0.05)
camera_res[1:5]
camera_res[1:5, ]
# how many significant at FDR < 0.05?
table(fgsea_res$padj < 0.05)
